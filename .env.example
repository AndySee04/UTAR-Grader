# ===== Core App =====
SECRET_KEY=change-this-in-production
DATABASE_URL=sqlite:///./backend/auto_grade.db

# ===== Ollama (local provider) =====
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b
# Student answer refresh OCR via vision (ollama pull llama3.2-vision:11b)
OLLAMA_VISION_MODEL=llama3.2-vision:11b
OLLAMA_VISION_MAX_SIDE=1280

# Optional debug for Ollama payload/response logging
OLLAMA_DEBUG=0
OLLAMA_DEBUG_MAX_CHARS=8000

# ===== OpenRouter (remote provider) =====
# Leave empty if you only use local Ollama
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

# ===== CRAFT (EasyOCR detector) tuning =====
# Preset: balanced | faint_handwriting | strict
CRAFT_PRESET=balanced
# Raise LINK threshold for larger character gaps.
# Raise TEXT threshold for stronger character region detection.
CRAFT_TEXT_THRESHOLD=0.82
CRAFT_LINK_THRESHOLD=0.62
CRAFT_LOW_TEXT=0.40

# Optional OCR diagnostics logging (prints line_count + avg_line_height per region)
OCR_DIAGNOSTICS=0
