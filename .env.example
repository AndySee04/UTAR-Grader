# ===== Core App =====
SECRET_KEY=change-this-in-production
DATABASE_URL=sqlite:///./backend/auto_grade.db

# ===== Ollama (local provider) =====
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# Optional debug for Ollama payload/response logging
OLLAMA_DEBUG=0
OLLAMA_DEBUG_MAX_CHARS=8000

# ===== OpenRouter (remote provider) =====
# Leave empty if you only use local Ollama
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=auto

# ===== CRAFT (EasyOCR detector) tuning =====
# Raise LINK threshold for larger character gaps.
# Raise TEXT threshold for stronger character region detection.
CRAFT_TEXT_THRESHOLD=0.74
CRAFT_LINK_THRESHOLD=0.55
CRAFT_LOW_TEXT=0.32