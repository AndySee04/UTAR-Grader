# ===== Core App =====
SECRET_KEY=change-this-in-production
DATABASE_URL=sqlite:///./backend/utar_grader.db

# ===== Ollama (local provider) =====
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Optional debug for Ollama payload/response logging
OLLAMA_DEBUG=0
OLLAMA_DEBUG_MAX_CHARS=8000

# ===== OpenRouter (cloud provider) =====
# Leave empty if you only use local Ollama
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=auto

# ===== CRAFT (EasyOCR detector) tuning =====
# Raise LINK threshold for larger character gaps.
# Raise TEXT threshold for stronger character region detection.
CRAFT_TEXT_THRESHOLD=0.74
CRAFT_LINK_THRESHOLD=0.55
CRAFT_LOW_TEXT=0.32

# ===== Email (Gmail SMTP) — sent when background grading finishes =====
# Use a Google "App password" if 2-Step Verification is on.
FRONTEND_BASE_URL=http://localhost:5173
REGISTRATION_VERIFY_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_HOURS=1

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=youremail@gmail.com
SMTP_PASSWORD=
SMTP_FROM_NAME=UTAR Grader